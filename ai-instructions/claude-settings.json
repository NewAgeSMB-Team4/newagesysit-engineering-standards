{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.envrc)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.test)",
      "Read(**/.env.testing)",
      "Read(**/.env.staging)",
      "Read(**/.env.stage)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.qa)",
      "Read(**/.env.uat)",
      "Read(**/.env.preview)",
      "Read(**/.env.sandbox)",
      "Read(**/.env.demo)",
      "Read(**/.env.ci)",
      "Read(**/.env.docker)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/.env.keys)",
      "Read(**/.env.vault)",
      "Read(**/.env.me)",
      "Read(**/.env*.bak)",
      "Read(**/.env*.backup)",
      "Read(**/.env*.old)",
      "Read(**/.env*.save)",
      "Read(**/.env*.orig)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)"
    ]
  }
}
