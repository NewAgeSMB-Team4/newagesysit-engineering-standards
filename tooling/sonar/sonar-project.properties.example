# Copy to sonar-project.properties and set project-specific values.
sonar.projectKey=YOUR_PROJECT_KEY
sonar.projectName=YOUR_PROJECT_NAME
sonar.sources=src
sonar.tests=src
sonar.test.inclusions=**/*.spec.ts,**/*.test.ts,**/*.spec.tsx,**/*.test.tsx
sonar.exclusions=node_modules/**,.next/**,dist/**,coverage/**
sonar.sourceEncoding=UTF-8
# Configure coverage report paths to match the project's test runner.
# sonar.javascript.lcov.reportPaths=coverage/lcov.info
